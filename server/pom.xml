<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- ADR-0001：Spring Boot 3.5 已 EOL，统一采用 4.1.x；与 liganex-studio-backend 实际代码一致 -->
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.liganex</groupId>
  <artifactId>liganex-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>liganex-server</name>
  <description>Liganex 后端多模块工程（闭环实现期形态，后续按仓库规划拆分独立仓）</description>

  <modules>
    <module>liganex-common</module>
    <module>liganex-order</module>
    <module>liganex-studio-backend</module>
    <module>liganex-mcp</module>
  </modules>

  <properties>
    <!-- ADR-0001：JDK 采用 Java 25 LTS -->
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <jjwt.version>0.13.0</jjwt.version>
    <postgresql.version>42.7.13</postgresql.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
