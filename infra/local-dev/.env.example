# 本地开发环境配置文件模板
#
# 用法：cp .env.example .env
# .env 已被 .gitignore 忽略，绝不入库（ADR-0007 开源红线）。
# 本文件只含本地 dev 占位值，不得填入任何真实凭证。

# ---------------- Postgres + pgvector ----------------
POSTGRES_DB=liganex
POSTGRES_USER=liganex
POSTGRES_PASSWORD=liganex_dev
POSTGRES_PORT=5432

# ---------------- Redis 8 ----------------
REDIS_PORT=6379

# ---------------- RocketMQ 5 ----------------
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_BROKER_VIP_PORT=10909
ROCKETMQ_PROXY_REMOTING_PORT=8080
ROCKETMQ_PROXY_GRPC_PORT=8081
ROCKETMQ_DASHBOARD_PORT=8180

# ---------------- 其它 ----------------
TZ=Asia/Shanghai
