# ===== Java / Maven / Gradle =====
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar
gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/generated/

# ===== Node / Frontend =====
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.next/
out/

# ===== IDE =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ===== OS =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===== Env / Secrets =====
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Local secret overrides (never commit real values)
application-*.local.yml
*.secret.yml
# Real per-env configs carry secrets; keep templates (.example) committable instead
application-prod.yml
application-test.yml

# ===== Local data / logs =====
data/
logs/
*.local

# ===== MCP / Skill runtime =====
.mcp/
.skill-cache/
